# Copy this file to .env and fill it in.

# Web address people use to reach the app (used in invite links and Stripe return pages).
BASE_URL=http://localhost:3000
PORT=3000

# A long random string that keeps logins secure. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first staff (review desk) login. Created on startup if it doesn't exist.
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=change-me-please

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
# Leave STRIPE_SECRET_KEY empty to run with simulated payments.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/stripe/webhook` or the Dashboard webhook page.
STRIPE_WEBHOOK_SECRET=

# Where the database and uploaded photos are stored.
DATA_DIR=./data
